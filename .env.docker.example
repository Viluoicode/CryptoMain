# Copy to .env.docker and fill in your values
# DO NOT commit .env.docker — it's in .gitignore

POSTGRES_DB=cryptodash
POSTGRES_USER=cryptodash
POSTGRES_PASSWORD=changeme-in-prod

# JWT secret — must be at least 32 characters
JWT_SECRET_KEY=replace-with-strong-secret-at-least-32-characters-long

# Optional — only needed if you want on-chain wallet balances
ALCHEMY_API_KEY=

# Optional — CoinGecko free tier works without a key
COINGECKO_API_KEY=

# Where the frontend should call the API from (browser perspective)
VITE_API_URL=http://localhost:8080
