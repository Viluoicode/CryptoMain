{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "MyConnect": "Server=localhost;Database=CryptoDashboardDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
    },
    "Jwt": {
        "SecretKey": "YourSuperSecretKeyMinimum32CharactersLong!@#$%^&*()",
        "Issuer": "CryptoDashboard",
        "Audience": "CryptoDashboardUsers",
        "AccessTokenExpirationMinutes": "15"
    },
    "CryptoApi": {
        "Provider": "CoinGecko",
        "BaseUrl": "https://api.coingecko.com/api/v3",
        "ApiKey": "",
        "RateLimitPerMinute": 10,
        "TimeoutSeconds": 30,
        "RetryCount": 3,
        "RetryBaseDelayMs": 1000
    }
}