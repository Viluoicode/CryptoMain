# ─── CryptoDash — Environment Variables ────────────────────────────────────────
# Copy this file to .env.local for development or .env.production for production.
# NEVER commit .env.local or .env.production to version control.
# All variables must be prefixed with VITE_ to be exposed to the client bundle.

# ─── Backend API URL ────────────────────────────────────────────────────────────
# Development: your local ASP.NET Core server (HTTPS with self-signed cert)
# Production:  your hosted API domain
VITE_API_URL=https://localhost:7103

# Examples:
#   Development:  VITE_API_URL=https://localhost:7103
#   Production:   VITE_API_URL=https://api.cryptodash.example.com
